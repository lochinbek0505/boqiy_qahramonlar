  "phases": [
    {
      "title": "Shahar tuzog'i",
      "text": "Nemis 6-armiyasi (Paulus) bir necha oydan beri Stalingrad xarobalarida ko'cha janglarida. Chuykovning 62-armiyasi Volga qirg'og'ida qattiq turibdi. 6-armiyaning uzun qanotlarini kam qurollangan Ruminiya armiyalari qo'riqlaydi.",
      "notes": [
        {
          "pos": [
            74,
