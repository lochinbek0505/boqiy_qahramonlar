  "phases": [
    {
      "title": "O'lja",
      "text": "Napoleon ataylab Pratsen tepaligini bo'shatdi va o'ng (janubiy) qanotini juda zaif qoldirdi. Sult korpusi soy bo'yidagi pastlikda, tuman ichida yashiringan.",
      "notes": [
        {
          "pos": [
            30,
            64
          ],
          "text": "Sult korpusi tumanda yashiringan",
          "kind": "weather"
        },
        {
          "pos": [
            30,
            86
          ],
          "text": "Ataylab zaif qanot",
          "kind": "trap"
        }
      ]
    },
    {
      "title": "Ittifoqchilar tuzoqqa tushadi",
      "text": "Ittifoqchilar fransuz qo'shinini Venadan uzib qo'yish uchun janubga — Telnits va Sokolnitsga yirik kolonnalar tashladi. Davu korpusi Venadan tunu kun yurib yetib keldi va chiziqni ushlab turdi.",
      "notes": [
        {
          "pos": [
            22,
            92
          ],
          "text": "Davu: ~2 kunda ~110 km yurish",
          "kind": "info"
        }
      ]
    },
    {
      "title": "«Austerlits quyoshi»",
      "text": "Tuman tarqalgan zahoti Sult korpusi yashirin joyidan chiqib, bo'shab qolgan Pratsen tepaligiga hujum qildi va uni egalladi. Ittifoqchilar qo'shini ikkiga bo'lindi.",
      "notes": [
        {
          "pos": [
            66,
            60
          ],
          "text": "Pratsen egallandi — markaz yorildi",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Shimoldagi jang va gvardiya",
      "text": "Shimolda Lann va Myura Bagration hamda Lixtenshteyn otliqlarini ushlab turdi. Rus gvardiyasining qarshi hujumi fransuz gvardiya otliqlari tomonidan qaytarildi.",
      "notes": [
        {
          "pos": [
            54,
            36
          ],
          "text": "Gvardiyalar to'qnashuvi",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Qopqon yopiladi",
      "text": "Sult korpusi janubga burilib, ittifoqchilarning chap qanotini Davu bilan birgalikda qisqichga oldi. Chekinayotgan qo'shinlar muzlagan ko'llar orqali qochishga urindi.",
      "notes": [
        {
          "pos": [
            74,
            82
          ],
          "text": "Muzlagan ko'llar orqali qochish",
          "kind": "water"
        }
      ]
    }
