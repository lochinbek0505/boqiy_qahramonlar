  "phases": [
    {
      "title": "Suv tuzog'i",
      "text": "Boyazid Temurni sharqda kutayotgan paytda, Temur aylanma yo'l bilan Anqara yoniga chiqdi va Usmonlilarning avvalgi lagerini hamda Chubuk soyini egalladi. Soy suvi burib yuborildi. Usmonli qo'shini jazirama issiqda suvsiz orqaga qaytishga majbur bo'ldi.",
      "notes": [
        {
          "pos": [
            84,
            30
          ],
          "text": "Soy suvi burib yuborildi",
          "kind": "water"
        },
        {
          "pos": [
            16,
            40
          ],
          "text": "Charchagan, chanqagan qo'shin",
          "kind": "info"
        }
      ]
    },
    {
      "title": "Charchagan qo'shin keladi",
      "text": "Usmonlilar bir necha kunlik tez yurishdan so'ng holdan toygan va chanqagan holda jangga saf tortadi. Temur qo'shini esa dam olgan, markaz oldida jang fillari turibdi.",
      "notes": [
        {
          "pos": [
            64,
            58
          ],
          "text": "Markaz oldida jang fillari",
          "kind": "info"
        }
      ]
    },
    {
      "title": "Qanotlardagi to'qnashuv",
      "text": "Temurning o'ng va chap qanotlari hujumga o'tadi. Serb og'ir otliqlari qattiq qarshi zarba berib, Temur qanotini bir oz orqaga suradi.",
      "notes": [
        {
          "pos": [
            48,
            14
          ],
          "text": "Serblarning kuchli zarbasi",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Tatarlar tomon o'zgartiradi",
      "text": "Jang qizigan paytda Boyazid safidagi Qora tatarlar va Anadolu beyliklari askarlari (ularning sobiq beklari Temur tomonida edi) Temur tarafiga o'tib ketadi. Usmonli o'ng qanoti yemiriladi.",
      "notes": [
        {
          "pos": [
            60,
            78
          ],
          "text": "Tatarlar Temur tomoniga o'tdi!",
          "kind": "betrayal"
        }
      ]
    },
    {
      "title": "Qamrab olish",
      "text": "Temur qanotlari va zaxira otliqlari Usmonli markazini ikki tomondan o'rab oladi. Serblar va shahzoda Sulaymon jang maydonidan chekinadi.",
      "notes": [
        {
          "pos": [
            20,
            30
          ],
          "text": "Qamal halqasi yopilmoqda",
          "kind": "trap"
        }
      ]
    },
    {
      "title": "Yakun",
      "text": "Boyazid yangicharilari bilan tepalikda kechgacha qarshilik ko'rsatdi, so'ng qochishga urinayotganda asirga olindi. Usmonlilar mag'lub bo'ldi.",
      "notes": [
        {
          "pos": [
            26,
            62
          ],
          "text": "Boyazid asirga olindi",
          "kind": "capture"
        }
      ]
    }
