  "phases": [
    {
      "title": "Kutilgan urush",
      "text": "Fransiya sharqiy chegarasini kuchli Mujino chizig'i bilan himoyalagan. Ittifoqchilar nemislar 1914-yildagidek Belgiya orqali hujum qiladi, deb kutmoqda.",
      "notes": [
        {
          "pos": [
            76,
            84
          ],
          "text": "Mujino chizig'i — kuchli istehkom",
          "kind": "info"
        }
      ]
    },
    {
      "title": "O'lja: Belgiya",
      "text": "10-may: B armiyalar guruhi Niderlandiya va Belgiyaga bostirib kirdi. Ittifoqchilarning eng yaxshi qo'shinlari (Britaniya korpusi, 1- va 7-fransuz armiyalari) Belgiyaga oldinga yugurdi — aynan nemislar xohlaganidek.",
      "notes": [
        {
          "pos": [
            44,
            4
          ],
          "text": "O'lja: ittifoqchilar Belgiyaga yugurdi",
          "kind": "trap"
        }
      ]
    },
    {
      "title": "Ardenn orqali",
      "text": "Ayni paytda uchta tank korpusi tor o'rmon yo'llari orqali Ardenndan o'tib, uch kunda Maas daryosiga yetib keldi. Bu yerni zaif fransuz armiyalari qo'riqlardi.",
      "notes": [
        {
          "pos": [
            80,
            34
          ],
          "text": "«O'tib bo'lmaydigan» o'rmon",
          "kind": "info"
        }
      ]
    },
    {
      "title": "Sedan yorib o'tildi",
      "text": "13-may: Ju-87 «Shtuka» pikirlovchi bombardimonchilari ko'magida nemislar Maasdan o'tdi. Fransuz 9- va 2-armiyalari safi yorildi.",
      "notes": [
        {
          "pos": [
            70,
            64
          ],
          "text": "Shtuka zarbasi, Maasdan o'tish",
          "kind": "air"
        }
      ]
    },
    {
      "title": "«O'roq zarbasi»",
      "text": "Tanklar orqaga qaramay g'arbga, dengiz tomon yugurdi va 20-mayda Abbevilga chiqdi. Shimoldagi ittifoqchilar qo'shini qolgan Fransiyadan butunlay uzib qo'yildi.",
      "notes": [
        {
          "pos": [
            20,
            56
          ],
          "text": "20-may: dengizga chiqildi",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Dyunkerk",
      "text": "Qamalda qolgan qo'shinlar Dyunkerkka siqildi. «Dinamo» operatsiyasida 338 mingga yaqin askar dengiz orqali Britaniyaga evakuatsiya qilindi, lekin barcha texnika tashlab ketildi.",
      "notes": [
        {
          "pos": [
            14,
            10
          ],
          "text": "«Dinamo» evakuatsiyasi",
          "kind": "water"
        }
      ]
    }
  ],
