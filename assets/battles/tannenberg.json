  "phases": [
    {
      "title": "Ikki rus armiyasi",
      "text": "Ikki rus armiyasi Sharqiy Prussiyaga bostirib kirdi, lekin ularni Mazur ko'llari ajratib turardi. Nemislar rus radiosi shifrsiz uzatgan buyruqlarni tutib oldi.",
      "notes": [
        {
          "pos": [
            58,
            80
          ],
          "text": "Rus radiosi shifrsiz!",
          "kind": "info"
        }
      ]
    },
    {
      "title": "Temir yo'l manevri",
      "text": "Nemislar shimoli-sharqdagi 1-rus armiyasiga qarshi faqat otliq to'siq qoldirdi. Fransua korpusi temir yo'l orqali g'arbiy qanotga, Makenzen va Byulov janubga ko'chirildi. Samsonov armiyasi esa shimolga, markazga qarab bexavotir ilgarilardi.",
      "notes": [
        {
          "pos": [
            12,
            32
          ],
          "text": "Temir yo'lda korpus ko'chirildi",
          "kind": "info"
        }
      ]
    },
    {
      "title": "O'ng qanot yemiriladi",
      "text": "Makenzen va Byulov korpuslari rus VI korpusini tor-mor qilib, chekinishga majbur qildi. Markazda XX nemis korpusi rus hujumini ushlab turdi.",
      "notes": [
        {
          "pos": [
            80,
            60
          ],
          "text": "VI korpus chekinmoqda",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Chap qanot yemiriladi",
      "text": "Fransua korpusi Usdau yonida rus I korpusini yorib o'tdi va sharqqa — Naydenburg tomon burildi.",
      "notes": [
        {
          "pos": [
            14,
            66
          ],
          "text": "Usdau yorib o'tildi",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Qisqich yopiladi",
      "text": "Nemis qisqichlari Villenberg yonida birlashdi. Rus markazidagi korpuslar o'rmonlarda qamalda qoldi. Samsonov halok bo'ldi, 90 mingdan ortiq askar asirga tushdi.",
      "notes": [
        {
          "pos": [
            60,
            88
          ],
          "text": "Qisqich yopildi",
          "kind": "trap"
        }
      ]
