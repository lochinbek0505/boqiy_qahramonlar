  "phases": [
    {
      "title": "Orqada daryo",
      "text": "Jaloliddin Sind daryosi qirg'og'ida saf tortdi: orqaga chekinish yo'li yo'q. Chingizxon qo'shini yarim oy shaklida yaqinlashdi.",
      "notes": [
        {
          "pos": [
            22,
            88
          ],
          "text": "Orqada daryo — chekinish yo'q",
          "kind": "trap"
        }
      ]
    },
    {
      "title": "Jaloliddin hujumi",
      "text": "Jaloliddin mardonavor hujum qilib, mo'g'ul markazini orqaga suradi. Mo'g'ul markazi ataylab chekinib, dushmanni o'ziga tortadi.",
      "notes": [
        {
          "pos": [
            52,
            60
          ],
          "text": "Markaz ataylab chekinmoqda",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Yashirin aylanma otryad",
      "text": "Chingizxon qanotlarni siqadi. Shu bilan birga, tanlab olingan otryad tog'lar ortidan aylanib o'tib, Jaloliddinning o'ng qanotiga yashirincha yaqinlashadi.",
      "notes": [
        {
          "pos": [
            58,
            84
          ],
          "text": "Tog' ortidan yashirin yurish",
          "kind": "trap"
        }
      ]
    },
    {
      "title": "Halqa yopiladi",
      "text": "O'ng qanot (Amin Malik) kutilmagan zarbadan tor-mor bo'ldi, chap qanot ham ezildi. Jaloliddin kichik guruh bilan daryo bo'yida qamalda qoldi.",
      "notes": [
        {
          "pos": [
            40,
            80
          ],
          "text": "O'ng qanot tor-mor",
          "kind": "attack"
        }
      ]
    },
    {
      "title": "Daryodan sakrash",
      "text": "Jaloliddin otini baland qirg'oqdan daryoga sakratib, qarshi qirg'oqqa suzib o'tdi. Rivoyatga ko'ra, Chingizxon o'g'illariga: «Otaning o'g'li shunday bo'lishi kerak», degan.",
      "notes": [
        {
          "pos": [
            8,
            36
          ],
          "text": "Otda daryodan sakrab o'tdi",
          "kind": "water"
        }
      ]
    }
  ],
